@using NamSitaKaurLMS.WebUI.Areas.Admin.Models.ViewModels
@model UserForCourseViewModel

<div class="modal fade" id="manageUserForCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header ">
                <div class="d-flex flex-row justify-content-between align-items-center w-75">
                    <h5 class="modal-title ">Kullanıcı İşlemleri </h5>
                    <h6 id="response-message" class="alert d-none mb-0"></h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            
            </div>

            <div class="modal-body">
                <input type="hidden" id="ModalCourseId" value="@Model.CourseId" />
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Kullanıcı</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                @*<td> <input type="checkbox" class="userIdCheckedValue" value="@u.Id" /></td> *@
                                <td> <button type="button" class="btn btn-outline-danger deleteUserSelectedValue" value="@u.Id">Sil</button> </td>
                                <td>@u.UserName</td>
                                <td>@u.Email</td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
