@using NamSitaKaurLMS.WebUI.Areas.Admin.Models.ViewModels
@model UpdateUserRoleViewModel

<div class="modal fade" id="updateUserRolePopup" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Kullanıcı Role Güncelleme (@Model.UserName) </h5>
            </div>

            <form id="updateUserRoleForm"
                  asp-area="Admin"
                  asp-controller="Dashboard"
                  asp-action="UpdateUser"
                  method="post"
            >
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <h3>@Model.UserId</h3>
                    <h3>@Model.UserName</h3>
                    <h3>@Model.CurrentRoleId</h3>
                    <h3>@Model.CurrentRoleName</h3>
                    <h3>@Model.NewRoleId</h3>
                    <h3>@Model.NewRoleName</h3>
                </div>
            </form>
        </div>
    </div>
</div>

