@section Scripts {
    <script>
        const popup = document.getElementById("popup");

        function showModal(modalId) {
          const el = document.getElementById(modalId);
          if (!el) return;
          bootstrap.Modal.getOrCreateInstance(el).show();
        }

        function hideModal(modalId) {
          const el = document.getElementById(modalId);
          if (!el) return;
          (bootstrap.Modal.getInstance(el) || bootstrap.Modal.getOrCreateInstance(el)).hide();
        }

        function cleanupBackdrop() {
          document.querySelectorAll(".modal-backdrop").forEach(b => b.remove());
          document.body.classList.remove("modal-open");
          document.body.style.removeProperty("padding-right");
        }

        function getAntiForgeryToken(container) {
          // Önce modal içindeki form
          let t = container?.querySelector('input[name="__RequestVerificationToken"]')?.value;
          if (t) return t;
          // Sonra sayfadaki af-form
          t = document.querySelector('#af-form input[name="__RequestVerificationToken"]')?.value;
          return t || null;
        }

        async function fetchHtml(url) {
          const res = await fetch(url, {
            credentials: "same-origin",
            headers: { "X-Requested-With": "XMLHttpRequest" }
          });
          if (!res.ok) throw new Error("HTTP " + res.status);
          return await res.text();
        }

        // -------------------------
        // CREATE MODAL OPEN + WIRE
        // -------------------------
        document.addEventListener("DOMContentLoaded", () => {
          const btnCreateCourse = document.getElementById("btnCreateCourse");
          if (!btnCreateCourse) return;

          btnCreateCourse.addEventListener("click", async (e) => {
            e.preventDefault();

            try {
              const url = '@Url.Action("CreateCourse", "Dashboard", new { area = "Admin" })';
              popup.innerHTML = await fetchHtml(url);

              wireCreateCourseForm();     // <-- kritik
              showModal("createCourseModal");
            } catch (err) {
              console.error(err);
              alert("Create modal açılırken hata oluştu.");
            }
          });
        });

        function wireCreateCourseForm() {
          const form = popup.querySelector("#createCourseForm");
          if (!form) {
            console.warn("createCourseForm bulunamadı. Partial içinde form id'si farklı olabilir.");
            return;
          }

          // aynı form tekrar inject edilirse event iki kere bağlanmasın
          if (form.dataset.wired === "1") return;
          form.dataset.wired = "1";

          // Kaydet butonu <a> bile olsa submit ettir
          const btnSave = popup.querySelector("#btnSaveCourse");
          if (btnSave) {
            btnSave.addEventListener("click", (e) => {
              e.preventDefault();
              form.requestSubmit(); // <-- Network’te POST'u garanti eder
            });
          }

          form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const btn = popup.querySelector("#btnSaveCourse");
            if (btn) btn.disabled = true;

            try {
              const token = getAntiForgeryToken(form);
              const url = form.action || '@Url.Action("CreateCourse", "Dashboard", new { area = "Admin" })';

              console.log("CREATE POST =>", url); // Network’te POST yoksa burası bile çalışmıyordur

              const res = await fetch(url, {
                method: "POST",
                body: new FormData(form),
                credentials: "same-origin",
                headers: {
                  "X-Requested-With": "XMLHttpRequest",
                  ...(token ? { "RequestVerificationToken": token } : {})
                }
              });

              if (!res.ok) throw new Error("HTTP " + res.status);

              const ct = (res.headers.get("content-type") || "").toLowerCase();

              if (ct.includes("application/json")) {
                const data = await res.json();
                if (data.success) {
                  hideModal("createCourseModal");
                  cleanupBackdrop();
                  window.location.href = data.redirectUrl || window.location.href;
                } else {
                  alert(data.message || "Kayıt başarısız.");
                }
                return;
              }

              // validation gibi HTML dönerse modal içinde güncelle
              popup.innerHTML = await res.text();
              wireCreateCourseForm(); // yeni gelen form için tekrar bağla
              showModal("createCourseModal");

            } catch (err) {
              console.error(err);
              alert("Kayıt sırasında hata oluştu.");
            } finally {
              if (btn) btn.disabled = false;
            }
          });
        }

        // -------------------------
        // UPDATE MODAL OPEN + WIRE
        // -------------------------
        document.addEventListener("click", async (e) => {
          const btn = e.target.closest(".btnUpdateCourse");
          if (!btn) return;

          e.preventDefault();
          const id = btn.dataset.id;
          if (!id) return;

          try {
            const baseUrl = '@Url.Action("UpdateCourse", "Dashboard", new { area = "Admin" })';
            const url = baseUrl + "?id=" + encodeURIComponent(id);

            popup.innerHTML = await fetchHtml(url);

            wireUpdateCourseForm();   // <-- kritik
            showModal("updateCourseModal");
          } catch (err) {
            console.error(err);
            alert("Update modal açılırken hata oluştu.");
          }
        });

        function wireUpdateCourseForm() {
          const form = popup.querySelector("#updateCourseForm");
          if (!form) {
            console.warn("updateCourseForm bulunamadı. Partial içinde form id'si farklı olabilir.");
            return;
          }

          if (form.dataset.wired === "1") return;
          form.dataset.wired = "1";

          form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const btnSubmit = form.querySelector('button[type="submit"]');
            if (btnSubmit) btnSubmit.disabled = true;

            try {
              const token = getAntiForgeryToken(form);

              console.log("UPDATE POST =>", form.action);

              const res = await fetch(form.action, {
                method: "POST",
                body: new FormData(form),
                credentials: "same-origin",
                headers: {
                  "X-Requested-With": "XMLHttpRequest",
                  ...(token ? { "RequestVerificationToken": token } : {})
                }
              });

              if (!res.ok) throw new Error("HTTP " + res.status);

              const ct = (res.headers.get("content-type") || "").toLowerCase();

              if (ct.includes("application/json")) {
                const data = await res.json();
                if (data.success) {
                  hideModal("updateCourseModal");
                  cleanupBackdrop();
                  window.location.reload();
                } else {
                  alert(data.message || "Güncelleme başarısız.");
                }
                return;
              }

              popup.innerHTML = await res.text();
              wireUpdateCourseForm();
              showModal("updateCourseModal");

            } catch (err) {
              console.error(err);
              alert("Güncelleme sırasında hata oluştu.");
            } finally {
              if (btnSubmit) btnSubmit.disabled = false;
            }
          });
        }
    </script>
}
