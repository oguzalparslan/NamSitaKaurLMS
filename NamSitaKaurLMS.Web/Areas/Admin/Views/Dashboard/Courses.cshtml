@{
    ViewData["Title"] = "Kurs Tanımlama";
}
@using System.Text.Json
@using NamSitaKaurLMS.WebUI.Areas.Admin.Models.ViewModels
@model List<CoursesViewModel>

<style>
    .table-center th,
    .table-center td {
        text-align: center;

        .table-center td.position-relative {
            text-align: unset !important;
            vertical-align: middle !important;
        }

            .table-center td.position-relative .badge {
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                right: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                height: 100%;        vertical-align: middle;
    }

                border-radius: 0.375rem;
            }
    #coursesGrid .tabulator-row.course-status-planned {
        background-color: #d1e7dd !important;
    }

    #coursesGrid .tabulator-row.course-status-continuing {
        background-color: #547f9c !important;
        color: #f2f2f2 !important;
    }
    #coursesGrid .tabulator-row.course-status-complated {
        background-color: #76cc90 !important;
    }

</style>
<div id="popup"></div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Aktif Kurslar</h6>
    </div>
    <div class="card-body">
        <div class="my-3">
            <a id="btnCreateCourse"
               class="btn btn-outline-success">
                Yeni Kurs Tanımla
            </a>
        </div>
        <div class="table-responsive">
            <div id="coursesGrid"></div>
        </div>
    </div>
    <form id="af-form">@Html.AntiForgeryToken()</form>

</div>                  



 @section Scripts {
 <script>
 const tableData = @Html.Raw(JsonSerializer.Serialize(Model));
var printIcon = function (cell, formatterParams) {
    return "<i class='fa fa-print'></i>";
};
var editIcon = function (cell, formatterParams) {
    return "<i class='fa fa-edit  text-primary'></i>";
};
var deleteIcon = function (cell, formatterParams) {
    return "<i class='fa fa-times text-danger'></i>";
};


var table = new Tabulator("#coursesGrid", {
    height: "calc(90vh - 280px)",
    width: "100%",
    data: tableData,

    layout: "fitColumns", // önemli olan burası

    pagination: "local",
    paginationSize: 20,
    paginationSizeSelector: [10, 20, 30, 40],

    rowFormatter: function(row) {
            var data = row.getData();
            var element = row.getElement();

            element.classList.remove("course-status-planned","course-status-continuing", "course-status-complated");
            
            if (data.Status == "Planlanan") { element.classList.add("course-status-planned");} 
            else if (data.Status == "Devam Eden") { element.classList.add("course-status-continuing");} 
            else if (data.Status == "Tamamlandı") { element.classList.add("course-status-complated");}
            },
    columns: [
        {
            formatter: editIcon,
            title: "Kurs Güncelle",
            width: 95,
            widthGrow: 0,
            hozAlign: "center",
            headerSort: false,
            cellClick: function (e, cell) {
            const selectedRowId = cell.getRow().getData().Id;
            openUpdatePopupPage(selectedRowId);
            },
            headerWordWrap: true
        },
        {
            formatter: deleteIcon,
            title: "Kurs Sil",
            width: 85,
            widthGrow: 0,
            hozAlign: "center",
            headerSort: false,
            cellClick: function (e, cell) {
            const selectedRowId = cell.getRow().getData().Id;
            deleteCourse(selectedRowId);
            },
            headerWordWrap: true
        },
        {
            title: "Id",
            field: "Id",
            width: 70,
            widthGrow: 0,
            headerHozAlign: "center"
        },
        {
            title: "Kurs Adı",
            field: "Title",
            minWidth: 180,
            widthGrow: 2,
            headerFilter: "input",
            headerHozAlign: "center"
        },
       
        {
            title: "Normalize Adı",
            field: "Slug",
            visible: false
        },
        {
            title: "ThumbnailUrl",
            field: "ThumbnailUrl",
            visible: false
        } ,

        {
            title: "Level",
            field: "Level",
            minWidth: 110,
            widthGrow: 1
        },
        {
            title: "Category",
            field: "Category",
            minWidth: 130,
            headerFilter: "input",
            widthGrow: 1
        },
        {
            title: "Price",
            field: "Price",
            minWidth: 90,
            widthGrow: 1
        },
        {
            title: "IsFree",
            field: "IsFree",
            minWidth: 90,
            widthGrow: 1
        },
        {
            title: "DurationMinutes",
            field: "DurationMinutes",
            minWidth: 130,
            widthGrow: 1
        },
        {
            title: "Language",
            field: "Language",
            minWidth: 110,
            widthGrow: 1
        },
        {
            title: "IsPublished",
            field: "IsPublished",
            minWidth: 120,
            widthGrow: 1
        },
        {
            title: "Status",
            field: "Status",
            minWidth: 120,
            widthGrow: 1
        },
        {
            title: "StartDate",
            field: "StartDate",
            minWidth: 120,
            widthGrow: 1
        },
        {
            title: "EndDate",
            field: "EndDate",
            minWidth: 120,
            widthGrow: 1
        },
        {
            title: "Quota",
            field: "Quota",
            minWidth: 90,
            widthGrow: 1
        },
        {
            title: "Environment",
            field: "Environment",
            minWidth: 120,
            widthGrow: 1
        },
        {
            title: "RemainingQuota",
            field: "RemainingQuota",
            minWidth: 140,
            widthGrow: 1
        }
    ]
});


          function openUpdatePopupPage(selectedRowId) {
          const popup = document.querySelector("#popup");
          const baseUrl = '@Url.Action("UpdateCourse", "Dashboard", new { area = "Admin" })';
          const url = baseUrl + "?id=" + encodeURIComponent(selectedRowId);
          fetch(url,{ credentials: "same-origin"})
          .then(response => response.text())
          .then(html => {
          popup.innerHTML = html;
          const modalEl = popup.querySelector("#updateCourseModal");
          const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
          NamsitaKaurLMSNotify.success("Modal başarılı bir şekilde yüklendi.");
          modal.show();
          })
          .catch(() => alert("Modal yüklenirken bir hata oluştu."));
          };

          function openCreatePopupPage() {
            
            const popup = document.querySelector("#popup");
            const baseUrl = '@Url.Action("CreateCourse", "Dashboard", new { area = "Admin" })';
            const url = baseUrl ;
            fetch(url,{ credentials: "same-origin"})
            .then(response => response.text())
            .then(html => {
            popup.innerHTML = html;
            const modalEl = popup.querySelector("#createCourseModal");
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            NamsitaKaurLMSNotify.warning("TEST");
            modal.show();
            })
            .catch(() => alert("Modal yüklenirken bir hata oluştu."));
            };
          
          function deleteCourse(selectedRowId) {
            

            console.log("deleteCourse fonksiyonuna geldi.");
            console.log("selectedRowId:", selectedRowId);

          

            const baseUrl = '@Url.Action("DeleteCourse", "Dashboard", new { area = "Admin" })';

            console.log("baseUrl:", baseUrl);

            const url = baseUrl + "?id=" + encodeURIComponent(selectedRowId);
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            console.log("fetch url:", url);

            $.ajax({
            url: baseUrl,
            method: "POST",
            data: {
            id: selectedRowId,
            __RequestVerificationToken: token
            },
            success: function() {
                alert("Kurs başarıyla silindi");
            window.location.href = '@Url.Action("Courses", "Dashboard", new { area = "Admin" })';
            },
            error: function(xhr) {
            console.error(xhr);
            alert("Kurs silinirken hata oluştu.");
            }
            });
          }
          
          document.addEventListener("DOMContentLoaded", () => {
          const btnCreateCourse = document.getElementById("btnCreateCourse");
          if (!btnCreateCourse) return;

          btnCreateCourse.addEventListener("click", async (e) => {
            e.preventDefault();
            try {
             openCreatePopupPage();
            } catch (err) {
              console.error(err);
              alert("Create modal açılırken hata oluştu.");
            }
          });
         
        });
 </script>
 }

