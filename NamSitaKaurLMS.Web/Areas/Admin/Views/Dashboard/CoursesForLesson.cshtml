@{
    ViewData["Title"] = "Kurslar";
}


@using NamSitaKaurLMS.WebUI.Areas.Admin.Models.ViewModels
@model List<CoursesViewModel>

@{
    ViewData["Title"] = "Kurs İçerik Girişi";
}

<div id="popup"></div>
<table class="table table-bordered table-hover align-middle w-100">
    <thead>
        <tr>
            <th>Kurs Adı</th>
            <th>Durum</th>
            <th>Başlangıç Tarihi</th>
            <th>Bitiş Tarihi</th>
            <th>Kontenjan</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.Title</td>
                <td>@course.Status</td>
                <td>@course.StartDate</td>
                <td>@course.EndDate</td>
                <td>@course.Quota</td>
                <td>
                    <a asp-action="CreateCourseLesson"
                       asp-controller="Dashboard"
                       asp-area="Admin"
                       asp-route-id="@course.Id"
                       class="btn btn-outline-secondary">
                        Dersler
                    </a>
                    <button type="button" value="@course.Id"
                            class="btn btn-outline-success btnAddUserForCourse">
                        Kullanıcı Girişi
                    </button>
                    <button type="button" value="@course.Id"
                            class="btn btn-outline-info btnManageUsersForCourse">
                        Kullanıcı İşlemleri
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    const popup = document.getElementById("popup");
    
    // NOT: btnAddAllSelectedUsers tanımlamasını buradan kaldırdık çünkü sayfa yüklenirken o buton yok.

    document.addEventListener("DOMContentLoaded", function () {
        
        // 1. Modal Açma İşlemi (Sizin kodunuzun aynısı)
        document.addEventListener("click", async function (e) {
            const element = e.target.closest(".btnAddUserForCourse");
            if (!element) return;

            e.preventDefault();
            const courseId = element.value;

            const baseUrl = '@Url.Action("AddUserForCoursePopup", "Dashboard", new { area = "Admin" })';
            const url = `${baseUrl}?courseId=${encodeURIComponent(courseId)}`;

            try {
                const res = await fetch(url, { credentials: "same-origin" });
                if (res.ok) {
                    const html = await res.text();
                    popup.innerHTML = html;

                    const modalEl = document.getElementById("addUserForCourseModal");
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }
            } catch (err) {
                console.error("Modal yüklenirken hata:", err);
            }
        });

        // 2. MODAL İÇİNDEKİ KAYDET BUTONU (Delegation)
        document.addEventListener("click", async function (e) {
            const saveBtn = e.target.closest("#addSelectedUsers");
            if (!saveBtn) return;

            console.log("Kaydet butonu tetiklendi!");

            saveBtn.setAttribute("disabled", "disabled");

            const selectedUserIds = [];
            document.querySelectorAll(".userIdCheckedValue:checked").forEach(chk => {
                selectedUserIds.push(chk.value);
            });

            console.log(            JSON.stringify(selectedUserIds));


            const courseId = document.getElementById("CourseId").value;

            if (selectedUserIds.length === 0) {
                alert("Lütfen en az bir kullanıcı seçin.");
                return;
            }

            // Test için bilgileri yazdıralım
            console.log("Course ID:", courseId, "Seçilenler:", selectedUserIds);


            const payload = { courseId: parseInt(courseId), userIds: selectedUserIds };

            console.log(payload);
            const baseUrl = '@Url.Action("AddUsersToCourse", "Dashboard", new { area = "Admin" })';
            try {
                const response = await fetch(baseUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        // Anti-Forgery Token (Güvenlik için önemli)
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify(payload) // Veriyi JSON'a serialize ediyoruz
        });

        if (response.ok) {
            const result = await response.json();
            
            if (result.success) {
                // alert(result.message);
                
                // Modalı kapat
                // const modalEl = document.getElementById("addUserForCourseModal");
                // const modalInstance = bootstrap.Modal.getInstance(modalEl);
                // modalInstance.hide();

                // Sayfayı yenileyebilir veya tabloyu güncelleyebilirsin
                location.reload(); 
            } else {
                alert("Hata: " + result.message);
            }
        } else {
            alert("Sunucu hatası oluştu (HTTP " + response.status + ")");
        }
    } catch (error) {
        console.error("İstek sırasında hata:", error);
        alert("İşlem gerçekleştirilemedi.");
    }
            saveBtn.removeAttribute("disabled");

        });

    });


    document.addEventListener("click", async function (e) {
            const element = e.target.closest(".btnManageUsersForCourse");
            if (!element) return;

            e.preventDefault();
            const courseId = element.value;

            const baseUrl = '@Url.Action("ManageUserForCoursePopup", "Dashboard", new { area = "Admin" })';
            const url = `${baseUrl}?courseId=${encodeURIComponent(courseId)}`;

            try {
                const res = await fetch(url, { credentials: "same-origin" });
                if (res.ok) {
                    const html = await res.text();
                    popup.innerHTML = html;

                    const modalEl = document.getElementById("manageUserForCourseModal");
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }
            } catch (err) {
                console.error("Modal yüklenirken hata:", err);
            }
        });

            function showResponseMessage(text, type = "success", durationMs = 2000) {
      const el = document.getElementById("response-message");
      if (!el) return;

      // metin
      el.textContent = text;

      // görünür yap
      el.classList.remove("d-none");

      // istersen bootstrap alert sınıflarıyla renklendir (h6 ise bile class alır)
      el.classList.remove("alert-success", "alert-danger", "alert-warning", "alert-info");
      if (type === "success") el.classList.add("alert-success");
      else if (type === "danger") el.classList.add("alert-danger");
      else if (type === "warning") el.classList.add("alert-warning");
      else el.classList.add("alert-info");

      // önceki timeout varsa iptal et (arka arkaya mesajlarda sorun çıkmasın)
      if (el._hideTimer) clearTimeout(el._hideTimer);

      el._hideTimer = setTimeout(() => {
        el.textContent = "";
        el.classList.add("d-none"); // tamamen gizle
      }, durationMs);
    }

            document.addEventListener("click", async function (e) {
      var deleteUserElement = e.target.closest(".deleteUserSelectedValue");
      if (!deleteUserElement) return;

      const courseId = document.getElementById("ModalCourseId")?.value;
      const userId = deleteUserElement.value; // butonsa value yoksa data attr kullan (aşağıda not)

      const baseUrl = '@Url.Action("RemoveUserByCourse", "Dashboard", new { area = "Admin" })';
      const url = `${baseUrl}?courseId=${encodeURIComponent(courseId)}&userId=${encodeURIComponent(userId)}`;

      // Anti-forgery token varsa header'a koy (action'da ValidateAntiForgeryToken varsa şart)
      const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

      try {
        const response = await fetch(url, {
          method: "DELETE",
          credentials: "same-origin",
          headers: token ? { "RequestVerificationToken": token } : {}
        });

        // 500/400 gibi hatalarda server'ın döndürdüğünü görmek için:
        const raw = await response.text();

        if (!response.ok) {
          console.error("HTTP:", response.status, raw);
          alert(`Hata: ${response.status} (Network > Response'a bak)`);
          return;
        }

        // Server JSON dönüyorsa:
        let data;
        try { data = JSON.parse(raw); } catch { data = {}; }

        if (data.success === true || data.status === true) {
          showResponseMessage("Kullanıcı kurstan silindi.", "success", 2000);
          deleteUserElement.closest("tr")?.remove();
        } else {
          showResponseMessage(data.message ?? "Silme başarısız", "danger", 2000);
        }
      } catch (err) {
        console.error(err);
        alert("İstek atılırken hata oluştu. Console'u kontrol et.");
      }
    });
</script>