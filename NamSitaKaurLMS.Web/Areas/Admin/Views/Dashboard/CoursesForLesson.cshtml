@using System.Text.Json
@using NamSitaKaurLMS.WebUI.Areas.Admin.Models.ViewModels
@model List<CoursesViewModel>

@{
    ViewData["Title"] = "Kurs İçerik Girişi";
}

<div id="popup"></div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Aktif Kurslar</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <div id="coursesGrid"></div>
        </div>
    </div>
    <form id="af-form">@Html.AntiForgeryToken()</form>

</div>
<style>
    /* ================================
           Courses Tabulator Theme
           ================================ */

    #coursesGrid {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e4d8f4;
        background: #fff;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    }

        #coursesGrid .tabulator-header {
            background: linear-gradient(135deg, #e8d7ff, #d9f5e6) !important;
            border-bottom: 1px solid #d7c7ee;
            color: #3d2f4f;
            font-weight: 700;
        }

        #coursesGrid .tabulator-col {
            background: transparent !important;
            border-right: 1px solid rgba(120, 90, 150, 0.18);
        }

        #coursesGrid .tabulator-col-title {
            color: #3d2f4f;
            font-size: 13px;
            font-weight: 700;
        }

        #coursesGrid .tabulator-row {
            border-bottom: 1px solid #f1edf7;
            background-color: #ffffff;
            transition: background-color 0.15s ease;
        }

            #coursesGrid .tabulator-row:nth-child(even) {
                background-color: #fbf8ff;
            }

            #coursesGrid .tabulator-row:hover {
                background-color: #f0e8ff !important;
                color: #2f243d !important;
            }

        #coursesGrid .tabulator-cell {
            border-right: 1px solid #f0edf4;
            padding: 10px 12px;
            font-size: 13px;
            vertical-align: middle;
            white-space: normal !important;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        #coursesGrid .tabulator-footer {
            background: #faf7ff;
            border-top: 1px solid #e4d8f4;
        }

        #coursesGrid .tabulator-page {
            border-radius: 8px;
            border: 1px solid #d7c7ee;
            background: #ffffff;
            color: #5b3f7a;
            margin: 0 2px;
            padding: 4px 9px;
        }

            #coursesGrid .tabulator-page.active {
                background: #7e57c2 !important;
                color: #fff !important;
                border-color: #7e57c2 !important;
            }

            #coursesGrid .tabulator-page:hover {
                background: #eee3ff;
                color: #3d2f4f;
            }

        #coursesGrid .tabulator-header-filter input {
            border-radius: 8px;
            border: 1px solid #d7c7ee;
            padding: 5px 8px;
            outline: none;
            font-size: 12px;
        }

            #coursesGrid .tabulator-header-filter input:focus {
                border-color: #7e57c2;
                box-shadow: 0 0 0 2px rgba(126, 87, 194, 0.15);
            }

        /* Status bazlı satır renkleri */
        #coursesGrid .tabulator-row.course-status-planned {
            background-color: #eefaf3 !important;
        }

        #coursesGrid .tabulator-row.course-status-continuing {
            background-color: #eef5ff !important;
            color: #24364f !important;
        }

        #coursesGrid .tabulator-row.course-status-complated {
            background-color: #f2ecff !important;
            color: #3d2f4f !important;
        }

            #coursesGrid .tabulator-row.course-status-planned:hover,
            #coursesGrid .tabulator-row.course-status-continuing:hover,
            #coursesGrid .tabulator-row.course-status-complated:hover {
                background-color: #e6dbff !important;
                color: #2f243d !important;
            }

        /* İşlem butonları */
        #coursesGrid .grid-action-btn {
            border-radius: 999px;
            padding: 5px 12px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

            #coursesGrid .grid-action-btn:hover {
                transform: translateY(-1px);
            }

    .table-center th,
    .table-center td {
        text-align: center;

        .table-center td.position-relative {
            text-align: unset !important;
            vertical-align: middle !important;
        }

            .table-center td.position-relative .badge {
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                right: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                height: 100%;
                vertical-align: middle;
            }

        border-radius: 0.375rem;
    }

    #coursesGrid .tabulator-row.course-status-planned {
        background-color: #e7f1ff !important;
        color: #084298 !important;
    }

    #coursesGrid .tabulator-row.course-status-continuing {
        background-color: #fff3cd !important;
        color: #664d03 !important;
    }

    #coursesGrid .tabulator-row.course-status-complated {
        background-color: #d1e7dd !important;
        color: #0f5132 !important;
    }

    #coursesGrid .tabulator-row.course-status-planned:hover {
        background-color: #cfe2ff !important;
    }

    #coursesGrid .tabulator-row.course-status-continuing:hover {
        background-color: #ffecb5 !important;
    }

    #coursesGrid .tabulator-row.course-status-complated:hover {
        background-color: #badbcc !important;
    }
</style>

@section Scripts {
    <script>
        const tableData = @Html.Raw(JsonSerializer.Serialize(Model));

        function actionButton(text, btnClass) {
            return function () {
                return `
                    <button type="button" class="btn btn-sm ${btnClass} grid-action-btn">
                        ${text}
                    </button>
                `;
            };
        }

        var table = new Tabulator("#coursesGrid", {
            height: "calc(90vh - 280px)",
            width: "100%",
            data: tableData,
            layout: "fitColumns",

            pagination: "local",
            paginationSize: 20,
            paginationSizeSelector: [10, 20, 30, 40],

            rowFormatter: function (row) {
                const data = row.getData();
                const element = row.getElement();

                element.classList.remove(
                    "course-status-planned",
                    "course-status-continuing",
                    "course-status-complated"
                );

                if (data.Status === "Planlanan") {
                    element.classList.add("course-status-planned");
                }
                else if (data.Status === "Devam Eden") {
                    element.classList.add("course-status-continuing");
                }
                else if (data.Status === "Tamamlandı") {
                    element.classList.add("course-status-complated");
                }
            },

            columns: [
                {
                    title: "Id",
                    field: "Id",
                    width: 70,
                    widthGrow: 0,
                    hozAlign: "center",
                    headerHozAlign: "center"
                },
                {
                    title: "Kurs Adı",
                    field: "Title",
                    minWidth: 200,
                    widthGrow: 2,
                    headerFilter: "input",
                    headerHozAlign: "center"
                },
                {
                    title: "Normalize Adı",
                    field: "Slug",
                    visible: false
                },
                {
                    title: "ThumbnailUrl",
                    field: "ThumbnailUrl",
                    visible: false
                },
                {
                    title: "Kategori",
                    field: "Category",
                    minWidth: 140,
                    headerFilter: "input",
                    widthGrow: 1,
                    headerHozAlign: "center"
                },
                {
                    title: "Durum",
                    field: "Status",
                    minWidth: 130,
                    widthGrow: 1,
                    headerFilter: "input",
                    hozAlign: "center",
                    headerHozAlign: "center"
                },
                {
                    title: "Başlangıç",
                    field: "StartDate",
                    minWidth: 120,
                    widthGrow: 1,
                    hozAlign: "center",
                    headerHozAlign: "center"
                },
                {
                    title: "Bitiş",
                    field: "EndDate",
                    minWidth: 120,
                    widthGrow: 1,
                    hozAlign: "center",
                    headerHozAlign: "center"
                },
                {
                    title: "İşlemler",
                    headerHozAlign: "center",
                    columns: [
                        {
                            formatter: actionButton("Dersler", "btn-primary"),
                            title: "Dersler",
                            hozAlign: "center",
                            headerHozAlign: "center",
                            headerSort: false,
                            minWidth: 120,
                            widthGrow: 1,
                            cellClick: function (e, cell) {
                                const selectedRowId = cell.getRow().getData().Id;
                                redirectToLessonsPage(selectedRowId);
                            },
                            headerWordWrap: true
                        },
                        {
                            formatter: actionButton("Kullanıcı Girişi", "btn-warning"),
                            title: "Kullanıcı Girişi",
                            hozAlign: "center",
                            headerHozAlign: "center",
                            headerSort: false,
                            minWidth: 150,
                            widthGrow: 1,
                            cellClick: function (e, cell) {
                                const selectedRowId = cell.getRow().getData().Id;
                                openAddUserForCoursePopupPage(selectedRowId);
                            },
                            headerWordWrap: true
                        },
                        {
                            formatter: actionButton("Kullanıcı İşlemleri", "btn-info"),
                            title: "Kullanıcı İşlemleri",
                            hozAlign: "center",
                            headerHozAlign: "center",
                            headerSort: false,
                            minWidth: 170,
                            widthGrow: 1,
                            cellClick: function (e, cell) {
                                const selectedRowId = cell.getRow().getData().Id;
                                openUserOperationsPopupPage(selectedRowId);
                            },
                            headerWordWrap: true
                        }
                    ]
                }
            ]
        });

        function redirectToLessonsPage(courseId) {
            const url = "/Admin/Dashboard/CreateCourseLesson/" + encodeURIComponent(courseId);
            window.location.href = url;
        }

        function openAddUserForCoursePopupPage(selectedRowId) {
            const popup = document.querySelector("#popup");
            const baseUrl = '@Url.Action("AddUserForCoursePopup", "Dashboard", new { area = "Admin" })';
            const url = baseUrl + "?courseId=" + encodeURIComponent(selectedRowId);

            fetch(url, { credentials: "same-origin" })
                .then(response => response.text())
                .then(html => {
                    popup.innerHTML = html;

                    const modalEl = popup.querySelector("#addUserForCourseModal");

                    if (!modalEl) {
                        console.error("addUserForCourseModal bulunamadı.");
                        return;
                    }

                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

                    if (typeof NamsitaKaurLMSNotify !== "undefined") {
                        NamsitaKaurLMSNotify.success("Modal başarılı bir şekilde yüklendi.");
                    }

                    modal.show();
                })
                .catch(err => {
                    console.error(err);
                    alert("Modal yüklenirken bir hata oluştu.");
                });
        }

        function openUserOperationsPopupPage(selectedRowId) {
            const popup = document.querySelector("#popup");
            const baseUrl = '@Url.Action("ManageUserForCoursePopup", "Dashboard", new { area = "Admin" })';
            const url = baseUrl + "?courseId=" + encodeURIComponent(selectedRowId);

            fetch(url, { credentials: "same-origin" })
                .then(response => response.text())
                .then(html => {
                    popup.innerHTML = html;

                    const modalEl = popup.querySelector("#manageUserForCourseModal");

                    if (!modalEl) {
                        console.error("manageUserForCourseModal bulunamadı.");
                        return;
                    }

                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

                    if (typeof NamsitaKaurLMSNotify !== "undefined") {
                        NamsitaKaurLMSNotify.success("Modal başarılı bir şekilde yüklendi.");
                    }

                    modal.show();
                })
                .catch(err => {
                    console.error(err);
                    alert("Modal yüklenirken bir hata oluştu.");
                });
        }

        document.addEventListener("click", async function (e) {
            const addSelectedUsersButton = e.target.closest("#addSelectedUsers");

            if (!addSelectedUsersButton) return;

            e.preventDefault();

            const modalElement = addSelectedUsersButton.closest(".modal");
            const container = modalElement || document;

            const selectedUserIds = [];

            container
                .querySelectorAll(".userIdCheckedValue:checked")
                .forEach(chk => {
                    selectedUserIds.push(chk.value);
                });

            const courseId = container.querySelector("#CourseId")?.value;

            if (!courseId) {
                NamsitaKaurLMSNotify.danger("CourseId bulunamadı.");
                return;
            }

            if (selectedUserIds.length === 0) {
                NamsitaKaurLMSNotify.warning("Lütfen en az bir kullanıcı seçin.");
                return;
            }

            const payload = {
                courseId: parseInt(courseId, 10),
                userIds: selectedUserIds
            };

            const baseUrl = '@Url.Action("AddUsersToCourse", "Dashboard", new { area = "Admin" })';
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                addSelectedUsersButton.disabled = true;

                const response = await fetch(baseUrl, {
                    method: "POST",
                    credentials: "same-origin",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    NamsitaKaurLMSNotify.danger("Sunucu hatası oluştu. HTTP " + response.status);
                    return;
                }

                const result = await response.json();

                if (result.success) {
                    NamsitaKaurLMSNotify.success("Katılımcılar başarıyla eklendi.");

                    if (modalElement) {
                        const modal = bootstrap.Modal.getInstance(modalElement)
                            || bootstrap.Modal.getOrCreateInstance(modalElement);

                        modal.hide();
                    }
                }
                else {
                    NamsitaKaurLMSNotify.danger("Hata: " + result.message);
                }
            }
            catch (err) {
                console.error(err);
                NamsitaKaurLMSNotify.danger("Katılımcılar eklenirken beklenmeyen bir hata oluştu.");
            }
            finally {
                addSelectedUsersButton.disabled = false;
            }
        });

        document.addEventListener("click", async function (e) {
            const deleteUserElement = e.target.closest(".deleteUserSelectedValue");

            if (!deleteUserElement) return;

            e.preventDefault();

            const modalElement = deleteUserElement.closest(".modal");
            const container = modalElement || document;

            const courseId = container.querySelector("#ModalCourseId")?.value;
            const userId = deleteUserElement.value || deleteUserElement.dataset.userId;

            if (!courseId || !userId) {
                NamsitaKaurLMSNotify.danger("Kurs veya kullanıcı bilgisi bulunamadı.");
                return;
            }

            const baseUrl = '@Url.Action("RemoveUserByCourse", "Dashboard", new { area = "Admin" })';
            const url = `${baseUrl}?courseId=${encodeURIComponent(courseId)}&userId=${encodeURIComponent(userId)}`;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch(url, {
                    method: "DELETE",
                    credentials: "same-origin",
                    headers: token ? { "RequestVerificationToken": token } : {}
                });

                const raw = await response.text();

                if (!response.ok) {
                    console.error("HTTP:", response.status, raw);
                    NamsitaKaurLMSNotify.danger("Kullanıcı silinirken sunucu hatası oluştu.");
                    return;
                }

                let data;

                try {
                    data = JSON.parse(raw);
                } catch {
                    data = {};
                }

                if (data.success === true || data.status === true) {
                    NamsitaKaurLMSNotify.success("Kullanıcı başarıyla silindi.");
                    deleteUserElement.closest("tr")?.remove();
                }
                else {
                    NamsitaKaurLMSNotify.danger(data.message || "Kullanıcı silinirken hata oluştu.");
                }
            }
            catch (err) {
                console.error(err);
                NamsitaKaurLMSNotify.danger("İstek atılırken hata oluştu.");
            }
        });
    </script>
}