@{
    ViewData["Title"] = "Ders Tanımlama";
}

@using System.Text.Json

@model NamSitaKaurLMS.WebUI.Areas.Admin.Models.ViewModels.LessonViewModel
@{
    var lessonGridData = Model.lessonDtoList.Select(lesson =>
    {
        var content = Model.lessonContentList?
            .FirstOrDefault(x => x.LessonId == lesson.LessonId);

        return new
        {
            Id = lesson.LessonId,
            CourseId = lesson.CourseId,
            lesson.Order,
            lesson.Title,
            LessonDate = lesson.LessonDate.ToShortDateString(),
            lesson.DurationMinutes,
            IsPreview = lesson.IsPreview ? "Evet" : "Hayır",
            LessonContent = content?.Text ?? "İçerik Bulunamadı !"
        };
    }).ToList();
}
<style>
    #courseLessonGrid {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #ddd;
        background: #fff;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    }

        /* Header */
        #courseLessonGrid .tabulator-header {
            background: linear-gradient(135deg, #e8d7ff, #d9f5e6);
            border-bottom: 1px solid #d7c7ee;
            color: #3d2f4f;
            font-weight: 700;
        }

        /* Header hücreleri */
        #courseLessonGrid .tabulator-col {
            background: transparent;
            border-right: 1px solid rgba(120, 90, 150, 0.18);
        }

        /* Header title */
        #courseLessonGrid .tabulator-col-title {
            color: #3d2f4f;
            font-size: 13px;
        }

        /* Satırlar */
        #courseLessonGrid .tabulator-row {
            border-bottom: 1px solid #f1edf7;
            background-color: #ffffff;
        }

            /* Alternatif satır rengi */
            #courseLessonGrid .tabulator-row:nth-child(even) {
                background-color: #fbf8ff;
            }

            /* Hover */
            #courseLessonGrid .tabulator-row:hover {
                background-color: #f0e8ff !important;
            }

        /* Hücreler */
        #courseLessonGrid .tabulator-cell {
            border-right: 1px solid #f0edf4;
            padding: 10px 12px;
            font-size: 13px;
            vertical-align: middle;
        }

        /* Footer / pagination */
        #courseLessonGrid .tabulator-footer {
            background: #faf7ff;
            border-top: 1px solid #e4d8f4;
        }

        /* Pagination butonları */
        #courseLessonGrid .tabulator-page {
            border-radius: 8px;
            border: 1px solid #d7c7ee;
            background: #ffffff;
            color: #5b3f7a;
            margin: 0 2px;
        }

            /* Aktif pagination */
            #courseLessonGrid .tabulator-page.active {
                background: #7e57c2;
                color: #fff;
                border-color: #7e57c2;
            }

        /* Filter input */
        #courseLessonGrid .tabulator-header-filter input {
            border-radius: 8px;
            border: 1px solid #d7c7ee;
            padding: 5px 8px;
            outline: none;
        }

        /* Ders içeriği text wrap */
        #courseLessonGrid .lesson-content-wrap {
            white-space: pre-wrap;
            word-break: break-word;
            overflow-wrap: anywhere;
            line-height: 1.45;
        }
</style>
<div id="lessonPopup"></div>

<form id="antiForgeryForm" method="post">
    @Html.AntiForgeryToken()
</form>



<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">@Model.Course.Title</h6>
    </div>
    <div class="card-body">
        <div class="my-3">
            <a id="btnCreateLesson"
               class="btn btn-outline-success mb-3"
               data-course-id="@Model.Course.Id">
                Yeni Ders Tanımla
            </a>
        </div>
        <div id="courseLessonGrid"></div>
    </div>
</div>


@section Scripts {

    
    <script>
        
var printIcon = function (cell, formatterParams) {
    return "<i class='fa fa-print'></i>";
};

var editIcon = function (cell, formatterParams) {
    return "<i class='fa fa-edit  text-primary'></i>";
};

var deleteIcon = function (cell, formatterParams) {
    return "<i class='fa fa-times text-danger'></i>";
};

function actionButton(text, btnClass) {
    return function (cell, formatterParams) {
        return `
                                    <button type="button" class="btn btn-sm ${btnClass}">
                                        ${text}
                                    </button>
                                `;
    };
}

const tableData = @Html.Raw(JsonSerializer.Serialize(lessonGridData));

var table = new Tabulator("#courseLessonGrid", {
    height: "calc(90vh - 280px)",
    width: "100%",
    data: tableData,
    layout: "fitColumns",
    pagination: "local",
    paginationSize: 10,
    paginationSizeSelector: [10, 20, 30, 40],

    columns: [
        {
            title: "Id",
            field: "Id",
            minWidth: 70,
            widthGrow: 0,
            headerHozAlign: "center"
        },
        {
            title: "Sıra",
            field: "Order",
            minWidth: 80,
            widthGrow: 0,
            headerHozAlign: "center"
        },
        {
            title: "Ders Adı",
            field: "Title",
            minWidth: 180,
            widthGrow: 2,
            headerFilter: "input",
            headerHozAlign: "center"
        },
        {
            title: "Ders Tarihi",
            field: "LessonDate",
            minWidth: 120,
            widthGrow: 1,
            headerHozAlign: "center"
        },
        {
            title: "Süre",
            field: "DurationMinutes",
            minWidth: 100,
            widthGrow: 1,
            headerHozAlign: "center"
        },
        {
            title: "Önizleme Mi?",
            field: "IsPreview",
            minWidth: 120,
            widthGrow: 1,
            headerHozAlign: "center"
        },
        {
            title: "Ders İçeriği",
            field: "LessonContent",
            minWidth: 220,
            widthGrow: 2,
            headerHozAlign: "center"
        },
        {
            title: "İşlemler",
            headerHozAlign: "center",
            columns: [
                {
                    formatter: actionButton("Ders İçeriği Gir", "btn-primary"),
                    title: "İçerik Gir",
                    hozAlign: "center",
                    headerSort: false,
                    minWidth: 140,
                    cellClick: function (e, cell) {
                        const rowData = cell.getRow().getData();

                        const courseId = rowData.CourseId;
                        const lessonId = rowData.Id;

                        // const baseUrl = '@Url.Action("CreateLessonContentForm", "Dashboard", new { area = "Admin" })';
                        // openLessonPopup(`${baseUrl}?courseId=${courseId}&lessonId=${lessonId}`);
                        openLessonContentPopup(courseId, lessonId);
                    }
                },
                {
                    // formatter: actionButton("Ders İçeriği Sil", "btn-warning"),
                    formatter: function (cell) {
                        const data = cell.getRow().getData();

                        const hasContent = data.LessonContent && data.LessonContent !== "İçerik Bulunamadı !";

                        if (!hasContent) {
                            return ` 
                                                            <button class="btn btn-warning btn-sm disabled" disabled>
                                                            Ders İçeriği Sil
                                                            </button>`;
                        }

                        return `
                                                        <button class="btn btn-warning btn-sm">
                                                            Ders İçeriği Sil
                                                        </button>`;
                    },
                    title: "İçerik Sil",
                    hozAlign: "center",
                    headerSort: false,
                    minWidth: 140,
                    cellClick: async function (e, cell) {

                        const btn = e.target.closest("button");

                        if (!btn) return;

                        if (btn.dataset.disabled === "1") {
                            e.stopPropagation();
                            return;
                        }
                        const rowData = cell.getRow().getData();

                        const lessonId = rowData.Id;
                        const courseId = rowData.CourseId;

                        await deleteLessonContent(lessonId, courseId, cell);
                    }
                },
                {
                    formatter: actionButton("Dersi Sil", "btn-danger"),
                    title: "Dersi Sil",
                    hozAlign: "center",
                    headerSort: false,
                    minWidth: 120,
                    cellClick: async function (e, cell) {
                        const rowData = cell.getRow().getData();

                        const lessonId = rowData.Id;
                        const courseId = rowData.CourseId;

                        deleteLesson(lessonId, courseId);
                    }
                }
            ]
        }
    ]
});



document.addEventListener("click", async function (e) {

    const createLessonBtn = e.target.closest("#btnCreateLesson");

    if (!createLessonBtn) return;

    e.preventDefault();

    const courseId = createLessonBtn.dataset.courseId;

    if (!courseId) {
        alert("CourseId bulunamadı.");
        return;
    }

    const baseUrl = '@Url.Action("CreateLessonForm", "Dashboard", new { area = "Admin" })';
    const url = `${baseUrl}?courseId=${encodeURIComponent(courseId)}`;

    try {
        const res = await fetch(url, {
            credentials: "same-origin"
        });

        if (!res.ok) {
            alert("Popup yüklenirken hata oluştu. HTTP: " + res.status);
            return;
        }

        const html = await res.text();

        const popupContainer = document.getElementById("lessonPopup");

        if (!popupContainer) {
            alert("#lessonPopup elementi bulunamadı.");
            return;
        }

        popupContainer.innerHTML = html;

        const modalElement = popupContainer.querySelector("#createLessonModal");

        if (!modalElement) {
            console.error("Gelen HTML:", html);
            alert("#createLessonModal partial içinde bulunamadı.");
            return;
        }

        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

        modal.show();

    } catch (err) {
        console.error(err);
        alert("Modal açılırken beklenmeyen hata oluştu.");
    }
});


async function openLessonContentPopup(courseId, lessonId) {
    const modalId = "createLessonModal";
    // CreateLessonContentForm

    const baseUrl = '@Url.Action("CreateLessonContentForm", "Dashboard", new { area = "Admin" })';
    const url = `${baseUrl}?courseId=${encodeURIComponent(courseId)}&lessonId=${encodeURIComponent(lessonId)}`;

    // NamsitaKaurLMSNotify.success(url);

    const res = await fetch(url, { credentials: "same-origin" });
    if (!res.ok) {
        alert("Popup yüklenirken hata oluştu. HTTP: " + res.status);
        return;
    }

    const html = await res.text();

    const popupContainer = document.getElementById("lessonPopup");

    if (!popupContainer) {
        alert("#lessonPopup elementi bulunamadı.");
        return;
    }

    popupContainer.innerHTML = html;

    const modalElement = popupContainer.querySelector("#createLessonModal");

    if (!modalElement) {
        console.error("Gelen HTML:", html);
        alert("#createLessonModal partial içinde bulunamadı.");
        return;
    }

    const modal = bootstrap.Modal.getOrCreateInstance(modalElement);

    modal.show();

}


function deleteLessonContent(lessonId, courseId, cell) {



    NamsitaKaurLMSNotify.success("lessonId" + lessonId);
    NamsitaKaurLMSNotify.success("courseId" + courseId);

    const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;

    if (lessonId !== 0 && courseId !== 0) {

        const baseUrl = '@Url.Action("DeleteCourseContent", "Dashboard", new { area = "Admin" })';
        const url = `${baseUrl}?lessonId=${encodeURIComponent(lessonId)}&courseId=${encodeURIComponent(courseId)}`;
        NamsitaKaurLMSNotify.success("sileceyik" + url);



        try {
            const res = fetch(url, {
                credentials: "same-origin",
                method: "POST", headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
            });

            if (!res.success) {
                NamsitaKaurLMSNotify.error(res.message);
            }

            NamsitaKaurLMSNotify.success(res.message);
        }
        catch (ex) {

            console.error("Hata : " + ex + " !!!");
        }


    }
}



            function deleteLesson(lessonId, courseId) {
                        if (lessonId !== 0 && courseId !== 0) {

                        const baseUrl = '@Url.Action("DeleteLesson", "Dashboard", new { area = "Admin" })';
                const url = `${baseUrl}?id=${encodeURIComponent(lessonId)}&courseId=${encodeURIComponent(courseId)}`;
                NamsitaKaurLMSNotify.success("sileceyik" + url);

                            const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]').value;


                try {
                    const res = fetch(url, {
                        credentials: "same-origin",
                        method: "POST", headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": token
                        },
                    });

                    if (!res.success) {
                        NamsitaKaurLMSNotify.error(res.message);
                    }

                    NamsitaKaurLMSNotify.success(res.message);
                }
                catch (ex) {

                    console.error("Hata : " + ex + " !!!");
                }


            }
            }
          
    </script>

}
