@using NamSitaKaurLMS.WebUI.Models

@{
    ViewData["Title"] = "Şifre Değiştir";
}

@model ChangePasswordViewModel




<div class="container mt-3">
    <h4 class="mb-3">Şifre Değiştirme Formu</h4>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-info" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
    </div>

    <form asp-controller="Profile" asp-action="ChangePassword" method="post">
        <div class="row mb-3 align-items-center">
            <label asp-for="PasswordOld" class="col-sm-3 col-form-label"></label>
            <div class="col-sm-6">
                <input asp-for="PasswordOld" class="form-control form-control-sm" />
                <span asp-validation-for="PasswordOld" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <label asp-for="PasswordNew" class="col-sm-3 col-form-label"></label>
            <div class="col-sm-6">
                <input asp-for="PasswordNew" class="form-control form-control-sm" />
                <span asp-validation-for="PasswordNew" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3 align-items-center">
            <label asp-for="PasswordNewConfirm" class="col-sm-3 col-form-label"></label>
            <div class="col-sm-6">
                <input asp-for="PasswordNewConfirm" class="form-control form-control-sm" />
                <span asp-validation-for="PasswordNewConfirm" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3 align-items-center">
            <button type="submit" class="btn btn-primary btn-sm mt-1">
                Şifre Değiştir
            </button>
        </div>

        
    </form>
</div>
