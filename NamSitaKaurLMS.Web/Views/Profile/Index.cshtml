@using NamSitaKaurLMS.WebUI.Models
@model UserProfileViewModel
@{
        ViewData["Title"] = "Profilim";
    Layout = "~/Views/Shared/_LayoutApp.cshtml";
}


<div class="container py-4">
    <h1 class="h3 mb-3">Profilim</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex gap-3 align-items-center">
            <img src="@(Model.ProfileImageUrl ?? "/img/default.jpg")"
                 style="width:72px;height:72px;object-fit:cover;border-radius:50%;" />
            <div>
                <div class="fw-semibold">@Model.FullName</div>
                <div class="text-muted">@Model.Email</div>
                <div class="text-muted">@Model.PhoneNumber</div>
                @if (Model.Roles?.Any() == true)
                {
                    <div class="mt-2">
                        @foreach (var r in Model.Roles)
                        {
                            <span class="badge bg-secondary me-1">@r</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>


</div>
