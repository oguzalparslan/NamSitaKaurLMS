@model ICollection<UserCoursesViewModel>
@using NamSitaKaurLMS.WebUI.Models
@{
    ViewData["Title"] = "Kurslarım";
    Layout = "_LayoutApp";
}

<!-- Tabulator (Bootstrap 5 theme) -->
<link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.2.5/dist/css/tabulator_bootstrap5.min.css" />

<style>
    .action-col {
        width: 220px;
    }

    .action-link {
        position: relative !important; /* en kritik satır */
        display: flex;
        width: 100%;
        justify-content: center;
        align-items: center;
        text-align: center;
        white-space: nowrap;
        padding: .5rem .75rem;
        line-height: 1.15;
        border: 1px solid var(--color-primary) !important;
    }

    .course-badge {
        position: absolute;
        top: -8px; /* butonun üstünde dursun */
        right: 10px;
        z-index: 2;
        background: var(--color-primary);
        color: #fff;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: .70rem;
        max-width: 85%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-link:hover{
      background-color:var(--color-primary) !important;
            color: aliceblue !important;
        border: 1px solid var(--color-primary) !important;
        }
</style>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Kurslarım</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <div id="courses-table"></div>
        </div>
    </div>

    <form id="af-form">@Html.AntiForgeryToken()</form>
</div>

@section Scripts {
    <script src="https://unpkg.com/tabulator-tables@6.2.5/dist/js/tabulator.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Server-rendered data -> Tabulator data
            const coursesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model ?? new List<UserCoursesViewModel>()));
            const lessonsBaseUrl = '@Url.Action("Index", "Lessons")';

            function actionFormatter(cell) {
                const d = cell.getRow().getData();
                const url = lessonsBaseUrl + "?courseId=" + encodeURIComponent(d.CourseId);
                return `
                    <div class="action-col">
                        <a href="${url}" class="btn btn-outline-info action-link text-primary">Derslere git</a>
                    </div>`;
            }

            // Best-effort numeric sort for LessonCount even if it comes as string
            function lessonCountSorter(a, b) {
                const na = parseInt(String(a ?? "").replace(/[^0-9-]/g, ""), 10);
                const nb = parseInt(String(b ?? "").replace(/[^0-9-]/g, ""), 10);
                const va = Number.isFinite(na) ? na : 0;
                const vb = Number.isFinite(nb) ? nb : 0;
                return va - vb;
            }

            new Tabulator("#courses-table", {
                data: coursesData,
                layout: "fitColumns",
                placeholder: "Kayıt bulunamadı.",
                columnDefaults: {
                    hozAlign: "center",
                    headerHozAlign: "center",
                    vertAlign: "middle",
                    headerSort: true,
                },
                columns: [
                    { title: "#", formatter: "rownum", width: 70, headerSort: false },
                    { title: "Adı", field: "Name" },
                    { title: "Açıklama", field: "Description" },
                    { title: "Ders Sayısı", field: "LessonCount", sorter: lessonCountSorter, width: 140 },
                    { title: "==>", formatter: actionFormatter, width: 220, headerSort: false },
                ],
            });
        });
    </script>
}

